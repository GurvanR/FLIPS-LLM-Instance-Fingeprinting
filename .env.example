# Copy this file to .env and fill in the values for your environment.
# .env is gitignored. Never commit real keys or personal paths.

# ── API keys ──────────────────────────────────────────────────────────────────

# OpenRouter API key — required to call OpenRouter-hosted models.
# Obtain yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Model cache ───────────────────────────────────────────────────────────────

# Absolute path to the HuggingFace hub cache directory (the "hub/" subdirectory).
# Leave unset to use the default: $HF_HOME/hub or ~/.cache/huggingface/hub
# On HPC clusters, point this at the shared model store, e.g.:
#   AUDIT_LLM_MODEL_CACHE_DIR=/path/to/your/hf/models/hub
AUDIT_LLM_MODEL_CACHE_DIR=

# ── PathConfig overrides (prefix: AUDIT_LLM_) ─────────────────────────────────
# These map to fields in audit_llm.config.PathConfig.
# All are optional; defaults are relative to the repository root.

# Base directory for datasets.
# Default: <repo_root>/datasets
AUDIT_LLM_DATASETS_DIR=

# Directory for experiment configuration presets.
# Default: <repo_root>/XP_configs/XP_config_libs
AUDIT_LLM_XP_CONFIGS_DIR=

# Path to the inference configuration YAML.
# Default: <repo_root>/scripts/Inference_configs.yaml
AUDIT_LLM_INFERENCE_CONFIGS_PATH=

# HuggingFace model cache directory (hub subdirectory).
# Prefer AUDIT_LLM_MODEL_CACHE_DIR above; this is the low-level override.
# Default: ~/.cache/huggingface/hub
AUDIT_LLM_HF_CACHE_DIR=

# Path to the model specifications CSV.
# Default: <repo_root>/datasets/model_specifications_df/model_specifications_df_1.csv
AUDIT_LLM_MODEL_SPECS_PATH=
